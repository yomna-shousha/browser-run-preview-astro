<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Preview Loop Lab</title>
	</head>
	<body>
		<main>
			<p class="eyebrow">Workers Previews + Browser Run</p>
			<h1>Every pull request gets a live Worker Preview.</h1>
			<p class="lede">
				This Astro starter deploys to Cloudflare Workers, captures the Preview in a real browser,
				and comments back on the pull request with the URL and screenshot.
			</p>
			<div class="panel">
				<span>1. Deploy Preview</span>
				<span>2. Capture Screenshot</span>
				<span>3. Comment on PR</span>
			</div>
		</main>
	</body>
</html>

<style>
	:root {
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: #13201a;
		background: #f5f1e8;
	}

	body {
		min-height: 100vh;
		margin: 0;
		background:
			radial-gradient(circle at 12% 16%, rgba(56, 189, 248, 0.18), transparent 24rem),
			linear-gradient(135deg, #f8f3e7 0%, #e9f1e2 100%);
	}

	main {
		display: grid;
		place-content: center;
		min-height: 100vh;
		box-sizing: border-box;
		padding: clamp(2rem, 8vw, 7rem);
	}

	.eyebrow {
		margin: 0 0 1rem;
		font-size: 0.85rem;
		font-weight: 800;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #16765f;
	}

	h1 {
		max-width: 900px;
		margin: 0;
		font-size: clamp(3rem, 10vw, 8rem);
		line-height: 0.88;
		letter-spacing: -0.08em;
	}

	.lede {
		max-width: 680px;
		margin: 2rem 0;
		font-size: clamp(1.1rem, 2vw, 1.45rem);
		line-height: 1.6;
		color: #415247;
	}

	.panel {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.panel span {
		border: 1px solid rgba(19, 32, 26, 0.16);
		border-radius: 999px;
		padding: 0.8rem 1rem;
		background: rgba(255, 255, 255, 0.52);
		box-shadow: 0 16px 50px rgba(34, 45, 38, 0.08);
		font-weight: 750;
	}
</style>
