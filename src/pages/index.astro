---
const checks = ["Preview URL", "Browser Run", "WOBS Signal", "PR comment"];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Preview Control Room</title>
		<script is:inline>
			const params = new URLSearchParams(window.location.search);
			const debugId = params.get("debugId") || `browser-run-${Date.now()}`;

			fetch(`/api/checkout?debugId=${encodeURIComponent(debugId)}`, {
				headers: { "x-debug-id": debugId },
			}).catch(() => {});

			fetch(`/api/session/refresh?debugId=${encodeURIComponent(debugId)}`, {
				headers: { "x-debug-id": debugId },
			}).catch(() => {});
		</script>
	</head>
	<body>
		<main>
			<section class="hero" aria-label="Preview control room">
				<div class="signal-card">
					<p class="eyebrow">Agent Review Loop</p>
					<h1>Preview is visible, and the runtime agrees.</h1>
					<p class="lede">
						Browser Run can prove the Preview renders. WOBS shows what happened inside the Worker
						while the browser clicked through the Preview.
					</p>
					<div class="actions">
						<a href="https://developers.cloudflare.com/workers/previews/">Workers Previews</a>
						<span>Runtime probe: clean</span>
					</div>
					<div class="runtime-alert" role="status">
						<strong>Verified fix</strong>
						<span>Session refresh is healthy in this Preview. Browser Run captures the UI and WOBS confirms the Worker request succeeds.</span>
					</div>
				</div>

				<div class="orbit" aria-hidden="true">
					<div class="ring ring-one"></div>
					<div class="ring ring-two"></div>
					<div class="core">PR</div>
					<div class="satellite satellite-a">URL</div>
					<div class="satellite satellite-b">PNG</div>
					<div class="satellite satellite-c">QA</div>
				</div>
			</section>

			<section class="checks" aria-label="Automation checklist">
				{checks.map((check, index) => <article style={`--index: ${index + 1}`}>{check}</article>)}
			</section>
		</main>
	</body>
</html>

<style>
	:root {
		font-family:
			"Space Grotesk", Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
			"Segoe UI", sans-serif;
		color: #f8fbff;
		background: #05050f;
	}

	body {
		min-height: 100vh;
		margin: 0;
		background:
			linear-gradient(120deg, rgba(255, 0, 128, 0.22), transparent 30%),
			radial-gradient(circle at 75% 20%, rgba(0, 240, 255, 0.42), transparent 24rem),
			radial-gradient(circle at 16% 80%, rgba(255, 221, 0, 0.26), transparent 22rem),
			#05050f;
		overflow-x: hidden;
	}

	body::before {
		position: fixed;
		inset: 0;
		pointer-events: none;
		content: "";
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
		background-size: 58px 58px;
		mask-image: linear-gradient(to bottom, black, transparent 85%);
	}

	main {
		box-sizing: border-box;
		width: min(1180px, 100%);
		min-height: 100vh;
		margin: 0 auto;
		padding: clamp(1.5rem, 4vw, 4rem);
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(300px, 0.92fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: center;
		min-height: 78vh;
	}

	.signal-card {
		position: relative;
		isolation: isolate;
		padding: clamp(1.5rem, 4vw, 3rem);
		border: 1px solid rgba(255, 255, 255, 0.22);
		border-radius: 36px;
		background: rgba(8, 10, 28, 0.7);
		box-shadow: 0 24px 90px rgba(0, 0, 0, 0.46), inset 0 1px 0 rgba(255, 255, 255, 0.2);
		backdrop-filter: blur(20px);
	}

	.signal-card::after {
		position: absolute;
		inset: -2px;
		z-index: -1;
		content: "";
		border-radius: inherit;
		background: linear-gradient(135deg, #00f0ff, #ff2ea6, #ffdf3d);
		filter: blur(24px);
		opacity: 0.36;
	}

	.eyebrow {
		margin: 0 0 1rem;
		font-size: 0.88rem;
		font-weight: 900;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: #7afcff;
	}

	h1 {
		max-width: 760px;
		margin: 0;
		font-size: clamp(3.5rem, 9vw, 8.6rem);
		line-height: 0.82;
		letter-spacing: -0.09em;
		text-wrap: balance;
	}

	.lede {
		max-width: 660px;
		margin: 2rem 0 0;
		font-size: clamp(1.05rem, 2vw, 1.38rem);
		line-height: 1.65;
		color: rgba(248, 251, 255, 0.76);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		margin-top: 2rem;
	}

	.actions a,
	.actions span {
		display: inline-flex;
		align-items: center;
		min-height: 48px;
		border-radius: 999px;
		padding: 0 1rem;
		font-weight: 850;
		text-decoration: none;
	}

	.actions a {
		color: #061018;
		background: #7afcff;
		box-shadow: 0 0 40px rgba(122, 252, 255, 0.45);
	}

	.actions span {
		border: 1px solid rgba(255, 255, 255, 0.24);
		color: #ffdf3d;
		background: rgba(255, 255, 255, 0.08);
	}

	.runtime-alert {
		display: grid;
		gap: 0.35rem;
		margin-top: 1.25rem;
		border: 1px solid rgba(122, 252, 255, 0.52);
		border-radius: 22px;
		padding: 1rem;
		background: rgba(122, 252, 255, 0.12);
		box-shadow: 0 0 46px rgba(122, 252, 255, 0.18);
	}

	.runtime-alert strong {
		font-size: 0.82rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: #7afcff;
	}

	.runtime-alert span {
		max-width: 640px;
		color: rgba(248, 251, 255, 0.82);
		line-height: 1.5;
	}

	.orbit {
		position: relative;
		aspect-ratio: 1;
		min-height: 420px;
	}

	.ring,
	.core,
	.satellite {
		position: absolute;
		border-radius: 999px;
	}

	.ring {
		inset: 12%;
		border: 2px solid rgba(122, 252, 255, 0.34);
		box-shadow: 0 0 80px rgba(0, 240, 255, 0.22);
	}

	.ring-two {
		inset: 24%;
		border-color: rgba(255, 46, 166, 0.36);
		transform: rotate(28deg) scaleX(0.74);
	}

	.core {
		inset: 32%;
		display: grid;
		place-items: center;
		font-size: clamp(5rem, 10vw, 8.5rem);
		font-weight: 950;
		letter-spacing: -0.12em;
		color: #05050f;
		background: conic-gradient(from 180deg, #7afcff, #ff2ea6, #ffdf3d, #7afcff);
		box-shadow: 0 0 90px rgba(255, 46, 166, 0.4);
	}

	.satellite {
		display: grid;
		place-items: center;
		width: 86px;
		height: 86px;
		font-weight: 900;
		color: #05050f;
		background: #f8fbff;
		box-shadow: 0 0 40px rgba(248, 251, 255, 0.42);
	}

	.satellite-a {
		top: 8%;
		right: 15%;
	}

	.satellite-b {
		bottom: 12%;
		right: 6%;
		background: #ffdf3d;
	}

	.satellite-c {
		bottom: 18%;
		left: 4%;
		background: #7afcff;
	}

	.checks {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.checks article {
		min-height: 110px;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 26px;
		padding: 1rem;
		background: rgba(255, 255, 255, 0.08);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16);
		font-size: clamp(1.1rem, 2.2vw, 1.8rem);
		font-weight: 900;
	}

	.checks article::before {
		display: block;
		margin-bottom: 1rem;
		content: "0" var(--index);
		font-size: 0.8rem;
		letter-spacing: 0.18em;
		color: #ffdf3d;
	}

	@media (max-width: 860px) {
		.hero,
		.checks {
			grid-template-columns: 1fr;
		}

		.orbit {
			min-height: 300px;
		}
	}
</style>
