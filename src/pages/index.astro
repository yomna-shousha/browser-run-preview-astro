---
const products = [
	{
		sku: "ASTRO-HOODIE",
		name: "Astro launch hoodie",
		price: "$64",
		accent: "#f6821f",
		description: "Soft fleece, preview-only colorway.",
	},
	{
		sku: "DO-MUG",
		name: "Durable Object mug",
		price: "$18",
		accent: "#fbbf24",
		description: "Keeps coffee and cart state warm.",
	},
	{
		sku: "EDGE-STICKER",
		name: "Workers sticker pack",
		price: "$9",
		accent: "#22c55e",
		description: "Tiny logos for laptops and runbooks.",
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Market</title>
	</head>
	<body>
		<main>
			<header class="site-header">
				<a class="brand" href="/" aria-label="Astro Market home">
					<span>cf</span>
					Astro Market
				</a>
				<nav aria-label="Main navigation">
					<a href="#shop">Shop</a>
					<a href="#cart">Cart</a>
					<a href="#shipping">Shipping</a>
				</nav>
				<div class="cart-chip">Cart <strong data-counter>42</strong></div>
			</header>

			<section class="hero" aria-label="Store introduction">
				<div class="hero-copy">
					<p class="eyebrow">Fresh from the edge</p>
					<h1>Astro merch for a launch week shop.</h1>
					<p>
						A small storefront for preview testing. The cart opens with seeded staging items, then saves updates in a Durable Object behind the page.
					</p>
					<div class="hero-actions">
						<a href="#shop">Shop the drop</a>
						<span>Cart saved at the edge</span>
					</div>
				</div>

				<article class="feature-card" id="cart">
					<div class="product-orbit" aria-hidden="true">
						<span></span>
						<span></span>
						<span></span>
					</div>
					<div class="cart-summary">
						<p>In your cart</p>
						<strong data-counter>42</strong>
						<span class="cart-label">items reserved for this preview</span>
						<small>Saved in a Durable Object</small>
					</div>
				</article>
			</section>

			<section class="product-grid" id="shop" aria-label="Featured products">
				{products.map((product) => (
					<article style={`--accent: ${product.accent}`}>
						<div class="product-art" aria-hidden="true"><span>{product.name.charAt(0)}</span></div>
						<div>
							<small>{product.sku}</small>
							<h2>{product.name}</h2>
							<p>{product.description}</p>
						</div>
						<footer>
							<strong>{product.price}</strong>
							<button type="button">Add</button>
						</footer>
					</article>
				))}
			</section>

			<section class="shipping" id="shipping">
				<div>
					<p class="eyebrow">Fulfilled by Workers</p>
					<h2>Fast preview checkout, seeded data, no production cart touched.</h2>
				</div>
				<ul>
					<li><span></span> Edge route is healthy</li>
					<li><span></span> Astro catalog loaded</li>
					<li><span></span> Durable Object cart updated</li>
				</ul>
			</section>
		</main>

		<script is:inline>
			const params = new URLSearchParams(window.location.search);
			const debugId = params.get("debugId") || `browser-run-${Date.now()}`;
			const headers = { "x-debug-id": debugId };
			const probes = [
				"/api/health",
				"/api/astro/feed",
				"/api/staging/cart",
				"/api/staging/cart/increment",
				"/api/cache/warm",
				"/api/observability/trace",
				"/api/observability/burst",
				"/api/session/refresh",
			];

			const setText = (selector, value) => {
				for (const element of document.querySelectorAll(selector)) {
					element.textContent = value;
				}
			};

			for (const path of probes) {
				fetch(`${path}?debugId=${encodeURIComponent(debugId)}`, { headers })
					.then(async (response) => {
						const body = await response.json().catch(() => ({}));
						if (body.counter) setText("[data-counter]", body.counter);
						if (body.cartId) setText("[data-cart-id]", body.cartId);
					})
					.catch(() => {});
			}
		</script>
	</body>
</html>

<style>
	:root {
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: #171717;
		background: #fbf6ee;
	}

	* {
		box-sizing: border-box;
	}

	body {
		min-height: 100vh;
		margin: 0;
		background:
			radial-gradient(circle at 12% 12%, rgba(246, 130, 31, 0.2), transparent 20rem),
			radial-gradient(circle at 84% 6%, rgba(251, 191, 36, 0.2), transparent 22rem),
			#fbf6ee;
	}

	main {
		width: min(1180px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 1.25rem 0 2rem;
	}

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		border: 1px solid rgba(109, 74, 28, 0.14);
		border-radius: 999px;
		padding: 0.7rem 0.8rem;
		background: rgba(255, 255, 255, 0.74);
		box-shadow: 0 18px 50px rgba(80, 54, 24, 0.08);
		backdrop-filter: blur(16px);
	}

	.brand,
	nav,
	.cart-chip,
	.hero-actions,
	.product-grid footer,
	.shipping,
	.shipping li {
		display: flex;
		align-items: center;
	}

	.brand {
		gap: 0.65rem;
		color: #171717;
		font-weight: 850;
		letter-spacing: -0.03em;
		text-decoration: none;
	}

	.brand span {
		display: grid;
		width: 38px;
		height: 38px;
		place-items: center;
		border-radius: 13px;
		color: #fff;
		background: #f6821f;
		font-weight: 900;
		letter-spacing: -0.07em;
	}

	nav {
		gap: 0.35rem;
	}

	nav a,
	.cart-chip,
	.hero-actions span {
		border-radius: 999px;
		padding: 0.65rem 0.9rem;
		color: #62574b;
		font-size: 0.92rem;
		font-weight: 750;
		text-decoration: none;
	}

	nav a:hover,
	.cart-chip {
		color: #171717;
		background: #fff1df;
	}

	.cart-chip {
		gap: 0.25rem;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 340px;
		gap: 1rem;
		align-items: stretch;
		margin-top: 1rem;
	}

	.hero-copy,
	.feature-card,
	.product-grid article,
	.shipping {
		border: 1px solid rgba(109, 74, 28, 0.14);
		border-radius: 34px;
		background: rgba(255, 255, 255, 0.76);
		box-shadow: 0 24px 80px rgba(80, 54, 24, 0.1);
	}

	.hero-copy {
		min-height: 390px;
		padding: clamp(2rem, 4vw, 3rem);
		background:
			radial-gradient(circle at 86% 18%, rgba(246, 130, 31, 0.22), transparent 18rem),
			linear-gradient(135deg, #ffffff, #fff4e4);
		color: #171717;
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: #c36b00;
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	h1,
	h2,
	p {
		margin-top: 0;
	}

	h1 {
		max-width: 650px;
		margin-bottom: 1rem;
		font-size: clamp(3rem, 5.5vw, 5.2rem);
		line-height: 0.96;
		letter-spacing: -0.07em;
	}

	h2 {
		margin-bottom: 0.45rem;
		font-size: 1.32rem;
		letter-spacing: -0.04em;
	}

	.hero-copy p {
		max-width: 650px;
		margin-bottom: 0;
		color: #6f6255;
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.hero-actions {
		gap: 0.7rem;
		margin-top: 2rem;
	}

	.hero-actions a,
	.product-grid button {
		border: 0;
		border-radius: 999px;
		padding: 0.8rem 1rem;
		color: #171717;
		background: #fbbf24;
		font: inherit;
		font-weight: 850;
		text-decoration: none;
	}

	.hero-actions span {
		color: #5e3a08;
		background: rgba(246, 130, 31, 0.12);
	}

	.feature-card {
		display: grid;
		grid-template-rows: 1fr auto;
		gap: 1rem;
		padding: 1rem;
		background: #fff;
	}

	.product-orbit {
		position: relative;
		overflow: hidden;
		min-height: 220px;
		border-radius: 28px;
		background: #171717;
	}

	.product-orbit span {
		position: absolute;
		border-radius: 999px;
	}

	.product-orbit span:nth-child(1) {
		width: 130px;
		height: 130px;
		top: 3rem;
		left: 50%;
		transform: translateX(-50%);
		background: #f6821f;
	}

	.product-orbit span:nth-child(2) {
		width: 86px;
		height: 86px;
		top: 4.35rem;
		left: 3.2rem;
		background: #fbbf24;
	}

	.product-orbit span:nth-child(3) {
		width: 96px;
		height: 96px;
		top: 4.8rem;
		right: 3.1rem;
		background: #ffffff;
	}

	.cart-summary {
		border-radius: 24px;
		padding: 1rem;
		background: #fff6e8;
	}

	.feature-card p {
		margin-bottom: 0.15rem;
		color: #6f6255;
		font-weight: 800;
	}

	.feature-card strong {
		font-size: 5rem;
		line-height: 0.9;
		letter-spacing: -0.08em;
	}

	.cart-label,
	.feature-card small {
		display: block;
		color: #6f6255;
		font-weight: 750;
	}

	.feature-card small {
		margin-top: 0.8rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.78rem;
	}

	.product-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		margin-top: 1rem;
	}

	.product-grid article {
		display: grid;
		gap: 1rem;
		padding: 1rem;
	}

	.product-art {
		display: grid;
		min-height: 190px;
		place-items: center;
		border-radius: 26px;
		background:
			radial-gradient(circle at 70% 30%, rgba(255, 255, 255, 0.82), transparent 4.5rem),
			linear-gradient(135deg, var(--accent), #171717);
	}

	.product-art span {
		display: grid;
		width: 86px;
		height: 86px;
		place-items: center;
		border-radius: 28px;
		color: #171717;
		background: rgba(255, 255, 255, 0.88);
		font-size: 3rem;
		font-weight: 900;
	}

	.product-grid small {
		color: #8a5a19;
		font-size: 0.74rem;
		font-weight: 850;
		letter-spacing: 0.12em;
	}

	.product-grid p {
		margin-bottom: 0;
		color: #6f6255;
		line-height: 1.5;
	}

	.product-grid footer {
		justify-content: space-between;
		gap: 1rem;
	}

	.product-grid footer strong {
		font-size: 1.35rem;
	}

	.product-grid button {
		padding: 0.68rem 1rem;
		background: #fff1df;
	}

	.shipping {
		justify-content: space-between;
		gap: 2rem;
		margin-top: 1rem;
		padding: 1.5rem;
	}

	.shipping h2 {
		max-width: 560px;
		margin-bottom: 0;
		font-size: clamp(1.8rem, 3vw, 2.8rem);
		line-height: 1;
	}

	.shipping ul {
		display: grid;
		gap: 0.65rem;
		min-width: 310px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.shipping li {
		gap: 0.55rem;
		border-radius: 999px;
		padding: 0.75rem 0.9rem;
		background: #f8efe4;
		font-weight: 800;
	}

	.shipping li span {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 999px;
		background: #22c55e;
	}

	@media (max-width: 920px) {
		.site-header,
		.hero,
		.product-grid,
		.shipping {
			grid-template-columns: 1fr;
		}

		.site-header,
		.shipping {
			align-items: flex-start;
			border-radius: 26px;
			flex-direction: column;
		}

		nav {
			flex-wrap: wrap;
		}

		.feature-card {
			min-height: 360px;
		}
	}
</style>
