---
const capacity = 120;
const initialReservations = 42;
const seatsLeft = capacity - initialReservations;
const highlights = ["Astro deploy walkthrough", "Live Q&A", "Preview-only guest list"];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Edge RSVP</title>
	</head>
	<body>
		<main>
			<header class="site-header">
				<a class="brand" href="/" aria-label="Edge RSVP home">
					<span>cf</span>
					Edge RSVP
				</a>
				<nav aria-label="Main navigation">
					<a href="#event">Event</a>
					<a href="#reserve">Reserve</a>
					<a href="#details">Details</a>
				</nav>
				<p>Powered by Durable Objects</p>
			</header>

			<section class="hero" id="event">
				<div class="event-copy">
					<p class="eyebrow">Astro community night</p>
					<h1>Reserve a seat for the launch preview.</h1>
					<p>
						A small RSVP page for a preview event. The guest count starts with seeded staging data, then updates at the edge when someone reserves a seat.
					</p>
					<div class="event-meta" aria-label="Event metadata">
						<div><span>Date</span><strong>Sep 12</strong></div>
						<div><span>Location</span><strong>Online</strong></div>
						<div><span>Capacity</span><strong>{capacity}</strong></div>
					</div>
				</div>

				<article class="reservation-card" id="reserve" aria-live="polite">
					<div class="event-art" aria-hidden="true">
						<span></span>
						<span></span>
						<span></span>
					</div>
					<p>Reserved seats</p>
					<strong data-reservations>{initialReservations}</strong>
					<div class="meter" aria-label={`${seatsLeft} seats left`}><span data-meter style={`width: ${(initialReservations / capacity) * 100}%`}></span></div>
					<small><span data-seats-left>{seatsLeft}</span> seats left</small>
					<button type="button" data-reserve>Reserve my seat</button>
				</article>
			</section>

			<section class="details" id="details">
				<div>
					<p class="eyebrow">Why this is in preview</p>
					<h2>The page behaves like a real RSVP flow without touching production data.</h2>
				</div>
				<ul>
					{highlights.map((highlight) => <li><span></span>{highlight}</li>)}
				</ul>
			</section>
		</main>

		<script is:inline define:vars={{ capacity }}>
			const params = new URLSearchParams(window.location.search);
			const debugId = params.get("debugId") || `browser-run-${Date.now()}`;
			const headers = { "x-debug-id": debugId };

			const updateReservationUI = (count) => {
				const safeCount = Math.min(Number(count) || 0, capacity);
				const seatsLeft = Math.max(capacity - safeCount, 0);
				document.querySelector("[data-reservations]").textContent = safeCount;
				document.querySelector("[data-seats-left]").textContent = seatsLeft;
				document.querySelector("[data-meter]").style.width = `${(safeCount / capacity) * 100}%`;
			};

			const loadReservations = async (path = "/api/staging/rsvp") => {
				const response = await fetch(`${path}?debugId=${encodeURIComponent(debugId)}`, { headers });
				const body = await response.json();
				if (body.reservations) updateReservationUI(body.reservations);
			};

			loadReservations().catch(() => {});
			document.querySelector("[data-reserve]")?.addEventListener("click", () => {
				loadReservations("/api/staging/rsvp/reserve").catch(() => {});
			});

			for (const path of [
				"/api/health",
				"/api/astro/feed",
				"/api/cache/warm",
				"/api/observability/trace",
				"/api/observability/burst",
				"/api/session/refresh",
			]) {
				fetch(`${path}?debugId=${encodeURIComponent(debugId)}`, { headers }).catch(() => {});
			}
		</script>
	</body>
</html>

<style>
	:root {
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: #171717;
		background: #fbf6ee;
	}

	* {
		box-sizing: border-box;
	}

	body {
		min-height: 100vh;
		margin: 0;
		background:
			radial-gradient(circle at 14% 10%, rgba(246, 130, 31, 0.2), transparent 20rem),
			radial-gradient(circle at 84% 12%, rgba(251, 191, 36, 0.2), transparent 22rem),
			#fbf6ee;
	}

	main {
		width: min(1120px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 1.5rem 0 2rem;
	}

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		border: 1px solid rgba(109, 74, 28, 0.14);
		border-radius: 999px;
		padding: 0.75rem 0.9rem;
		background: rgba(255, 255, 255, 0.78);
		box-shadow: 0 18px 50px rgba(80, 54, 24, 0.08);
		backdrop-filter: blur(16px);
	}

	.brand,
	nav,
	.event-meta,
	.details,
	.details li {
		display: flex;
		align-items: center;
	}

	.brand {
		gap: 0.65rem;
		color: #171717;
		font-weight: 850;
		letter-spacing: -0.03em;
		text-decoration: none;
	}

	.brand span {
		display: grid;
		width: 38px;
		height: 38px;
		place-items: center;
		border-radius: 13px;
		color: #fff;
		background: #f6821f;
		font-weight: 900;
		letter-spacing: -0.07em;
	}

	nav {
		gap: 0.4rem;
	}

	nav a,
	.site-header p {
		border-radius: 999px;
		padding: 0.65rem 0.9rem;
		color: #62574b;
		font-size: 0.92rem;
		font-weight: 750;
		text-decoration: none;
	}

	nav a:hover,
	.site-header p {
		color: #171717;
		background: #fff1df;
	}

	.site-header p,
	h1,
	h2,
	.event-copy p,
	.reservation-card p {
		margin: 0;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 370px;
		gap: 1rem;
		margin-top: 1rem;
	}

	.event-copy,
	.reservation-card,
	.details {
		border: 1px solid rgba(109, 74, 28, 0.14);
		border-radius: 34px;
		background: rgba(255, 255, 255, 0.78);
		box-shadow: 0 24px 80px rgba(80, 54, 24, 0.1);
	}

	.event-copy {
		display: grid;
		align-content: center;
		min-height: 520px;
		padding: clamp(2rem, 5vw, 4rem);
		background:
			radial-gradient(circle at 88% 20%, rgba(246, 130, 31, 0.24), transparent 18rem),
			linear-gradient(135deg, #ffffff, #fff4e4);
	}

	.eyebrow {
		margin-bottom: 1rem;
		color: #c36b00;
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 720px;
		font-size: clamp(3.5rem, 6.8vw, 6.3rem);
		line-height: 0.94;
		letter-spacing: -0.08em;
	}

	.event-copy p:not(.eyebrow) {
		max-width: 620px;
		margin-top: 1.25rem;
		color: #6f6255;
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.event-meta {
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.event-meta div {
		display: grid;
		gap: 0.18rem;
		min-width: 112px;
		border-radius: 20px;
		padding: 0.8rem 0.9rem;
		background: rgba(255, 255, 255, 0.72);
	}

	.event-meta span,
	.reservation-card p,
	.reservation-card small {
		color: #6f6255;
		font-weight: 750;
	}

	.event-meta strong {
		font-size: 1.15rem;
	}

	.reservation-card {
		display: grid;
		grid-template-rows: 220px auto auto auto auto;
		gap: 0.8rem;
		padding: 1rem;
	}

	.event-art {
		position: relative;
		overflow: hidden;
		border-radius: 28px;
		background: #171717;
	}

	.event-art span {
		position: absolute;
		border-radius: 999px;
	}

	.event-art span:nth-child(1) {
		width: 138px;
		height: 138px;
		top: 42px;
		left: 116px;
		background: #f6821f;
	}

	.event-art span:nth-child(2) {
		width: 94px;
		height: 94px;
		top: 66px;
		left: 62px;
		background: #fbbf24;
	}

	.event-art span:nth-child(3) {
		width: 96px;
		height: 96px;
		top: 70px;
		right: 58px;
		background: #fff;
	}

	.reservation-card strong {
		font-size: 6rem;
		line-height: 0.85;
		letter-spacing: -0.09em;
	}

	.meter {
		overflow: hidden;
		height: 12px;
		border-radius: 999px;
		background: #f6ead9;
	}

	.meter span {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: #f6821f;
	}

	.reservation-card button {
		width: 100%;
		border: 0;
		border-radius: 999px;
		padding: 0.95rem 1rem;
		color: #171717;
		background: #fbbf24;
		font: inherit;
		font-weight: 850;
		cursor: pointer;
	}

	.details {
		justify-content: space-between;
		gap: 2rem;
		margin-top: 1rem;
		padding: 1.5rem;
	}

	.details h2 {
		max-width: 650px;
		font-size: clamp(1.9rem, 3.4vw, 3.35rem);
		line-height: 0.98;
		letter-spacing: -0.07em;
	}

	.details ul {
		display: grid;
		gap: 0.7rem;
		min-width: 310px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.details li {
		gap: 0.55rem;
		border-radius: 999px;
		padding: 0.8rem 0.95rem;
		background: #f8efe4;
		font-weight: 800;
	}

	.details li span {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 999px;
		background: #22c55e;
	}

	@media (max-width: 880px) {
		.site-header,
		.hero,
		.details,
		.event-meta {
			grid-template-columns: 1fr;
		}

		.site-header,
		.details,
		.event-meta {
			align-items: flex-start;
			border-radius: 26px;
			flex-direction: column;
		}

		nav {
			flex-wrap: wrap;
		}
	}
</style>
