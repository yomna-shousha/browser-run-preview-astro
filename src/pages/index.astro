---
const signals = ["Edge route healthy", "Astro page loaded", "Counter saved"];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Counter</title>
	</head>
	<body>
		<main>
			<header class="site-header">
				<a class="brand" href="/" aria-label="Astro Counter home">
					<span>cf</span>
					Astro Counter
				</a>
				<nav aria-label="Main navigation">
					<a href="#counter">Counter</a>
					<a href="#how">How it works</a>
				</nav>
				<p>Powered by Durable Objects</p>
			</header>

			<section class="hero" id="counter">
				<div class="copy">
					<p class="eyebrow">Astro on Cloudflare</p>
					<h1>A tiny counter that survives every refresh.</h1>
					<p>
						This preview starts with seeded staging data, then stores each click at the edge. The page stays simple: one count, one button, and state that sticks.
					</p>
				</div>

				<article class="counter-card" aria-live="polite">
					<div class="counter-art" aria-hidden="true">
						<span></span>
						<span></span>
						<span></span>
					</div>
					<p>Current count</p>
					<strong data-counter>42</strong>
					<button type="button" data-increment>Count one more</button>
					<small>Saved for this preview session</small>
				</article>
			</section>

			<section class="details" id="how">
				<div>
					<p class="eyebrow">Built for previews</p>
					<h2>Refresh the page and the number is still there.</h2>
				</div>
				<ul>
					{signals.map((signal) => <li><span></span>{signal}</li>)}
				</ul>
			</section>
		</main>

		<script is:inline>
			const params = new URLSearchParams(window.location.search);
			const debugId = params.get("debugId") || `browser-run-${Date.now()}`;
			const headers = { "x-debug-id": debugId };

			const setCounter = (value) => {
				for (const element of document.querySelectorAll("[data-counter]")) {
					element.textContent = value;
				}
			};

			const loadCounter = async (path = "/api/staging/counter") => {
				const response = await fetch(`${path}?debugId=${encodeURIComponent(debugId)}`, { headers });
				const body = await response.json();
				if (body.counter) setCounter(body.counter);
				return body;
			};

			loadCounter().catch(() => {});
			document.querySelector("[data-increment]")?.addEventListener("click", () => {
				loadCounter("/api/staging/counter/increment").catch(() => {});
			});

			for (const path of [
				"/api/health",
				"/api/astro/feed",
				"/api/cache/warm",
				"/api/observability/trace",
				"/api/observability/burst",
				"/api/session/refresh",
			]) {
				fetch(`${path}?debugId=${encodeURIComponent(debugId)}`, { headers }).catch(() => {});
			}
		</script>
	</body>
</html>

<style>
	:root {
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: #171717;
		background: #fbf6ee;
	}

	* {
		box-sizing: border-box;
	}

	body {
		min-height: 100vh;
		margin: 0;
		background:
			radial-gradient(circle at 14% 12%, rgba(246, 130, 31, 0.2), transparent 20rem),
			radial-gradient(circle at 84% 10%, rgba(251, 191, 36, 0.2), transparent 22rem),
			#fbf6ee;
	}

	main {
		width: min(1120px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 1.5rem 0 2rem;
	}

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		border: 1px solid rgba(109, 74, 28, 0.14);
		border-radius: 999px;
		padding: 0.75rem 0.9rem;
		background: rgba(255, 255, 255, 0.78);
		box-shadow: 0 18px 50px rgba(80, 54, 24, 0.08);
		backdrop-filter: blur(16px);
	}

	.brand,
	nav,
	.details,
	.details li {
		display: flex;
		align-items: center;
	}

	.brand {
		gap: 0.65rem;
		color: #171717;
		font-weight: 850;
		letter-spacing: -0.03em;
		text-decoration: none;
	}

	.brand span {
		display: grid;
		width: 38px;
		height: 38px;
		place-items: center;
		border-radius: 13px;
		color: #fff;
		background: #f6821f;
		font-weight: 900;
		letter-spacing: -0.07em;
	}

	nav {
		gap: 0.4rem;
	}

	nav a,
	.site-header p {
		border-radius: 999px;
		padding: 0.65rem 0.9rem;
		color: #62574b;
		font-size: 0.92rem;
		font-weight: 750;
		text-decoration: none;
	}

	nav a:hover,
	.site-header p {
		color: #171717;
		background: #fff1df;
	}

	.site-header p,
	h1,
	h2,
	.copy p {
		margin: 0;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 370px;
		gap: 1rem;
		margin-top: 1rem;
	}

	.copy,
	.counter-card,
	.details {
		border: 1px solid rgba(109, 74, 28, 0.14);
		border-radius: 34px;
		background: rgba(255, 255, 255, 0.78);
		box-shadow: 0 24px 80px rgba(80, 54, 24, 0.1);
	}

	.copy {
		display: grid;
		align-content: center;
		min-height: 510px;
		padding: clamp(2rem, 5vw, 4rem);
		background:
			radial-gradient(circle at 88% 20%, rgba(246, 130, 31, 0.24), transparent 18rem),
			linear-gradient(135deg, #ffffff, #fff4e4);
	}

	.eyebrow {
		margin-bottom: 1rem;
		color: #c36b00;
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 720px;
		font-size: clamp(3.6rem, 7vw, 6.6rem);
		line-height: 0.94;
		letter-spacing: -0.08em;
	}

	.copy p:not(.eyebrow) {
		max-width: 620px;
		margin-top: 1.25rem;
		color: #6f6255;
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.counter-card {
		display: grid;
		grid-template-rows: 230px auto auto auto auto;
		gap: 0.8rem;
		padding: 1rem;
	}

	.counter-art {
		position: relative;
		overflow: hidden;
		border-radius: 28px;
		background: #171717;
	}

	.counter-art span {
		position: absolute;
		border-radius: 999px;
	}

	.counter-art span:nth-child(1) {
		width: 135px;
		height: 135px;
		top: 42px;
		left: 116px;
		background: #f6821f;
	}

	.counter-art span:nth-child(2) {
		width: 94px;
		height: 94px;
		top: 66px;
		left: 62px;
		background: #fbbf24;
	}

	.counter-art span:nth-child(3) {
		width: 96px;
		height: 96px;
		top: 70px;
		right: 58px;
		background: #fff;
	}

	.counter-card p {
		margin: 0;
		color: #6f6255;
		font-weight: 800;
	}

	.counter-card strong {
		font-size: 6rem;
		line-height: 0.85;
		letter-spacing: -0.09em;
	}

	.counter-card button {
		width: 100%;
		border: 0;
		border-radius: 999px;
		padding: 0.95rem 1rem;
		color: #171717;
		background: #fbbf24;
		font: inherit;
		font-weight: 850;
		cursor: pointer;
	}

	.counter-card small {
		color: #6f6255;
		font-weight: 750;
		text-align: center;
	}

	.details {
		justify-content: space-between;
		gap: 2rem;
		margin-top: 1rem;
		padding: 1.5rem;
	}

	.details h2 {
		max-width: 600px;
		font-size: clamp(2rem, 3.7vw, 3.7rem);
		line-height: 0.98;
		letter-spacing: -0.07em;
	}

	.details ul {
		display: grid;
		gap: 0.7rem;
		min-width: 310px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.details li {
		gap: 0.55rem;
		border-radius: 999px;
		padding: 0.8rem 0.95rem;
		background: #f8efe4;
		font-weight: 800;
	}

	.details li span {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 999px;
		background: #22c55e;
	}

	@media (max-width: 880px) {
		.site-header,
		.hero,
		.details {
			grid-template-columns: 1fr;
		}

		.site-header,
		.details {
			align-items: flex-start;
			border-radius: 26px;
			flex-direction: column;
		}

		nav {
			flex-wrap: wrap;
		}
	}
</style>
