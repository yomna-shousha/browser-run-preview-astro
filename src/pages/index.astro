---
const capacity = 120;
const initialReservations = 42;
const seatsLeft = capacity - initialReservations;
const highlights = [
	{ title: "Preview URLs", detail: "How every pull request gets a shareable environment." },
	{ title: "Browser checks", detail: "A real browser opens the page before anyone reviews it." },
	{ title: "Runtime signal", detail: "Worker requests are logged with the same preview debug ID." },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Previews Launch RSVP</title>
	</head>
	<body>
		<main>
			<header class="site-header">
				<a class="brand" href="/" aria-label="Previews Launch RSVP home">
					<span>cf</span>
					Previews Launch
				</a>
				<nav aria-label="Main navigation">
					<a href="#event">Event</a>
					<a href="#rsvp">RSVP</a>
					<a href="#details">Details</a>
				</nav>
				<p>Powered by Durable Objects</p>
			</header>

			<section class="hero" id="event">
				<div class="event-copy">
					<p class="eyebrow">Cloudflare Workers</p>
					<h1>Join the Previews launch.</h1>
					<p>
						Save a seat for a short walkthrough of Worker Previews, Browser Run screenshots, and the runtime signals that make review comments useful.
					</p>
					<div class="event-meta" aria-label="Event metadata">
						<div><span>Date</span><strong>Sep 12</strong></div>
						<div><span>Time</span><strong>10:00 AM PT</strong></div>
						<div><span>Place</span><strong>Online</strong></div>
					</div>
				</div>

				<form class="rsvp-card" id="rsvp" aria-label="Reserve a seat">
					<div class="card-top">
						<p class="eyebrow">RSVP</p>
						<span><strong data-seats-left>{seatsLeft}</strong> seats left</span>
					</div>

					<label>
						Name
						<input value="Preview Guest" aria-label="Name" />
					</label>
					<label>
						Email
						<input value="guest@example.com" aria-label="Email" />
					</label>

					<div class="reservation-count">
						<span>Reserved</span>
						<strong data-reservations>{initialReservations}</strong>
					</div>
					<div class="meter" aria-label={`${seatsLeft} seats left`}><span data-meter style={`width: ${(initialReservations / capacity) * 100}%`}></span></div>
					<button type="button" data-reserve>Reserve my seat</button>
				</form>
			</section>

			<section class="details" id="details" aria-label="What to expect">
				<div class="section-heading">
					<p class="eyebrow">What to expect</p>
					<h2>A preview flow you can see and verify.</h2>
				</div>
				<div class="detail-grid">
					{highlights.map((highlight) => (
						<article>
							<span></span>
							<h3>{highlight.title}</h3>
							<p>{highlight.detail}</p>
						</article>
					))}
				</div>
			</section>
		</main>

		<script is:inline define:vars={{ capacity }}>
			const params = new URLSearchParams(window.location.search);
			const debugId = params.get("debugId") || `browser-run-${Date.now()}`;
			const headers = { "x-debug-id": debugId };

			const updateReservationUI = (count) => {
				const safeCount = Math.min(Number(count) || 0, capacity);
				const seatsLeft = Math.max(capacity - safeCount, 0);
				document.querySelector("[data-reservations]").textContent = safeCount;
				document.querySelector("[data-seats-left]").textContent = seatsLeft;
				document.querySelector("[data-meter]").style.width = `${(safeCount / capacity) * 100}%`;
			};

			const loadReservations = async (path = "/api/staging/rsvp") => {
				const response = await fetch(`${path}?debugId=${encodeURIComponent(debugId)}`, { headers });
				const body = await response.json();
				if (body.reservations) updateReservationUI(body.reservations);
			};

			loadReservations().catch(() => {});
			document.querySelector("[data-reserve]")?.addEventListener("click", () => {
				loadReservations("/api/staging/rsvp/reserve").catch(() => {});
			});

			for (const path of [
				"/api/health",
				"/api/astro/feed",
				"/api/cache/warm",
				"/api/observability/trace",
				"/api/observability/burst",
				"/api/session/refresh",
			]) {
				fetch(`${path}?debugId=${encodeURIComponent(debugId)}`, { headers }).catch(() => {});
			}
		</script>
	</body>
</html>

<style>
	:root {
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: #171717;
		background: #fbf6ee;
	}

	* {
		box-sizing: border-box;
	}

	body {
		min-height: 100vh;
		margin: 0;
		background:
			radial-gradient(circle at 12% 10%, rgba(246, 130, 31, 0.18), transparent 19rem),
			radial-gradient(circle at 86% 12%, rgba(251, 191, 36, 0.22), transparent 22rem),
			#fbf6ee;
	}

	main {
		width: min(1060px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 1.5rem 0 2rem;
	}

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		border: 1px solid rgba(109, 74, 28, 0.12);
		border-radius: 999px;
		padding: 0.7rem 0.85rem;
		background: rgba(255, 255, 255, 0.82);
		box-shadow: 0 18px 50px rgba(80, 54, 24, 0.07);
		backdrop-filter: blur(16px);
	}

	.brand,
	nav,
	.card-top,
	.event-meta,
	.detail-grid {
		display: flex;
		align-items: center;
	}

	.brand {
		gap: 0.65rem;
		color: #171717;
		font-weight: 850;
		letter-spacing: -0.03em;
		text-decoration: none;
	}

	.brand span {
		display: grid;
		width: 36px;
		height: 36px;
		place-items: center;
		border-radius: 13px;
		color: #fff;
		background: #f6821f;
		font-weight: 900;
		letter-spacing: -0.07em;
	}

	nav {
		gap: 0.3rem;
	}

	nav a,
	.site-header p {
		border-radius: 999px;
		padding: 0.58rem 0.82rem;
		color: #62574b;
		font-size: 0.9rem;
		font-weight: 750;
		text-decoration: none;
	}

	nav a:hover,
	.site-header p {
		color: #171717;
		background: #fff1df;
	}

	.site-header p,
	h1,
	h2,
	h3,
	p {
		margin: 0;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 340px;
		gap: 1rem;
		margin-top: 1rem;
	}

	.event-copy,
	.rsvp-card,
	.details {
		border: 1px solid rgba(109, 74, 28, 0.12);
		border-radius: 30px;
		background: rgba(255, 255, 255, 0.82);
		box-shadow: 0 24px 70px rgba(80, 54, 24, 0.08);
	}

	.event-copy {
		display: grid;
		align-content: center;
		min-height: 430px;
		padding: clamp(2rem, 5vw, 3.6rem);
		background:
			radial-gradient(circle at 88% 16%, rgba(246, 130, 31, 0.18), transparent 17rem),
			linear-gradient(135deg, #ffffff, #fff5e8);
	}

	.eyebrow {
		margin-bottom: 0.8rem;
		color: #c36b00;
		font-size: 0.75rem;
		font-weight: 900;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 640px;
		font-size: clamp(3.2rem, 6vw, 5.4rem);
		font-weight: 850;
		line-height: 0.98;
		letter-spacing: -0.075em;
	}

	.event-copy p:not(.eyebrow) {
		max-width: 600px;
		margin-top: 1.2rem;
		color: #6f6255;
		font-size: 1.04rem;
		line-height: 1.65;
	}

	.event-meta {
		gap: 0.7rem;
		margin-top: 1.7rem;
	}

	.event-meta div {
		display: grid;
		gap: 0.15rem;
		min-width: 116px;
		border-radius: 18px;
		padding: 0.78rem 0.9rem;
		background: rgba(255, 255, 255, 0.7);
	}

	.event-meta span,
	.rsvp-card label,
	.card-top span,
	.reservation-count span {
		color: #71665a;
		font-size: 0.85rem;
		font-weight: 760;
	}

	.event-meta strong {
		font-size: 1.04rem;
	}

	.rsvp-card {
		display: grid;
		gap: 0.9rem;
		padding: 1.2rem;
	}

	.card-top {
		justify-content: space-between;
		gap: 1rem;
	}

	.card-top .eyebrow {
		margin: 0;
	}

	.card-top span {
		border-radius: 999px;
		padding: 0.45rem 0.7rem;
		background: #fff1df;
	}

	.rsvp-card label {
		display: grid;
		gap: 0.35rem;
	}

	.rsvp-card input {
		width: 100%;
		border: 1px solid #eadfce;
		border-radius: 16px;
		padding: 0.85rem 0.9rem;
		color: #171717;
		background: #fffaf4;
		font: inherit;
		font-weight: 700;
	}

	.reservation-count {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		border-radius: 22px;
		padding: 1rem;
		background: #fff6e8;
	}

	.reservation-count strong {
		font-size: 4.8rem;
		font-weight: 850;
		line-height: 0.85;
		letter-spacing: -0.08em;
	}

	.meter {
		overflow: hidden;
		height: 10px;
		border-radius: 999px;
		background: #f6ead9;
	}

	.meter span {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: #f6821f;
	}

	.rsvp-card button {
		width: 100%;
		border: 0;
		border-radius: 999px;
		padding: 0.9rem 1rem;
		color: #171717;
		background: #fbbf24;
		font: inherit;
		font-weight: 850;
		cursor: pointer;
	}

	.details {
		margin-top: 1rem;
		padding: 1.35rem;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1.5rem;
		margin-bottom: 1rem;
	}

	.section-heading h2 {
		max-width: 520px;
		font-size: clamp(1.8rem, 3vw, 2.75rem);
		font-weight: 850;
		line-height: 1;
		letter-spacing: -0.06em;
	}

	.detail-grid {
		gap: 0.85rem;
	}

	.detail-grid article {
		flex: 1;
		min-height: 132px;
		border-radius: 22px;
		padding: 1rem;
		background: #fff8ee;
	}

	.detail-grid article > span {
		display: block;
		width: 0.62rem;
		height: 0.62rem;
		margin-bottom: 1rem;
		border-radius: 999px;
		background: #22c55e;
	}

	.detail-grid h3 {
		margin-bottom: 0.35rem;
		font-size: 1rem;
	}

	.detail-grid p {
		color: #71665a;
		font-size: 0.94rem;
		line-height: 1.45;
	}

	@media (max-width: 880px) {
		.site-header,
		.hero,
		.section-heading,
		.event-meta,
		.detail-grid {
			grid-template-columns: 1fr;
		}

		.site-header,
		.section-heading,
		.event-meta,
		.detail-grid {
			align-items: flex-start;
			border-radius: 26px;
			flex-direction: column;
		}

		nav {
			flex-wrap: wrap;
		}
	}
</style>
