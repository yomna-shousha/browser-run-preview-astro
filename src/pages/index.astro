---
const metrics = [
	{ label: "Preview requests", value: "14.8k", note: "+18% after deploy" },
	{ label: "Seeded carts", value: "87", note: "staging data" },
	{ label: "Runtime probes", value: "200", note: "health and refresh" },
];

const events = [
	{ name: "preview_opened", detail: "Browser Run loaded /", status: "ok" },
	{ name: "astro_catalog_loaded", detail: "Astro page data returned", status: "ok" },
	{ name: "do_cart_counter_incremented", detail: "PreviewSession wrote seeded data", status: "ok" },
	{ name: "wobs_correlation_ready", detail: "debugId attached to every request", status: "ok" },
];

const products = [
	["ASTRO-HOODIE", "Astro hoodie", "1", "reserved"],
	["DO-MUG", "Durable Object mug", "2", "reserved"],
	["EDGE-STICKER", "Workers sticker pack", "4", "reserved"],
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Staging Cart</title>
	</head>
	<body>
		<main>
			<aside class="sidebar" aria-label="Cloudflare navigation">
				<div class="logo-mark">cf</div>
				<nav>
					<a class="active" href="/">Workers</a>
					<a href="/">Durable Objects</a>
					<a href="/">Observability</a>
					<a href="/">Deployments</a>
				</nav>
			</aside>

			<section class="workspace" aria-label="Astro staging dashboard">
				<header class="topbar">
					<div>
						<p class="eyebrow">Cloudflare Workers Preview</p>
						<h1>Astro staging cart</h1>
					</div>
					<div class="status-pill"><span></span> my-worker live</div>
				</header>

				<section class="hero-card">
					<div>
						<p class="label">Pull request environment</p>
						<h2>Durable Object state seeded for this preview.</h2>
						<p>
							Browser Run opens the preview URL, then the page and workflow send Worker requests with the same debug ID. WOBS gets page render, DO reads, DO writes, cache warmup, and session refresh events in one place.
						</p>
					</div>
					<div class="url-card">
						<span>Preview URL</span>
						<strong data-preview-url>https://preview.example.workers.dev</strong>
						<span>Debug ID</span>
						<strong data-debug-id>browser-run-preview</strong>
					</div>
				</section>

				<section class="metrics" aria-label="Preview metrics">
					{metrics.map((metric) => (
						<article>
							<span>{metric.label}</span>
							<strong>{metric.value}</strong>
							<small>{metric.note}</small>
						</article>
					))}
				</section>

				<section class="grid">
					<article class="panel do-panel">
						<div class="panel-heading">
							<div>
								<p class="label">Durable Object</p>
								<h3>PreviewSession</h3>
							</div>
							<span class="tag">seeded staging data</span>
						</div>
						<div class="counter-row">
							<div>
								<span>Cart counter</span>
								<strong data-counter>42</strong>
							</div>
							<div>
								<span>Object key</span>
								<strong data-cart-id>cart_pr_4_astro</strong>
							</div>
						</div>
						<table>
							<thead>
								<tr><th>SKU</th><th>Item</th><th>Qty</th><th>Status</th></tr>
							</thead>
							<tbody>
								{products.map((product) => (
									<tr><td>{product[0]}</td><td>{product[1]}</td><td>{product[2]}</td><td>{product[3]}</td></tr>
								))}
							</tbody>
						</table>
					</article>

					<article class="panel events-panel">
						<div class="panel-heading">
							<div>
								<p class="label">Observability</p>
								<h3>WOBS event stream</h3>
							</div>
							<span class="tag dark">trace ready</span>
						</div>
						<div class="event-list">
							{events.map((event) => (
								<div class="event-row">
									<span class="dot"></span>
									<div><strong>{event.name}</strong><small>{event.detail}</small></div>
									<em>{event.status}</em>
								</div>
							))}
						</div>
					</article>
				</section>

				<section class="probe-strip" aria-label="Runtime probes">
					<div><span>Health</span><strong data-probe="probe-health">queued</strong></div>
					<div><span>Astro feed</span><strong data-probe="probe-astro">queued</strong></div>
					<div><span>DO read</span><strong data-probe="probe-do">queued</strong></div>
					<div><span>DO write</span><strong data-probe="probe-counter">queued</strong></div>
					<div><span>Cache warm</span><strong data-probe="probe-cache">queued</strong></div>
					<div><span>Trace steps</span><strong data-probe="probe-trace">queued</strong></div>
					<div><span>Burst logs</span><strong data-probe="probe-burst">queued</strong></div>
					<div><span>Session refresh</span><strong data-probe="probe-session">queued</strong></div>
				</section>
			</section>
		</main>
		<script is:inline>
			const params = new URLSearchParams(window.location.search);
			const debugId = params.get("debugId") || `browser-run-${Date.now()}`;
			const headers = { "x-debug-id": debugId };
			const probes = [
				["/api/health", "probe-health"],
				["/api/astro/feed", "probe-astro"],
				["/api/staging/cart", "probe-do"],
				["/api/staging/cart/increment", "probe-counter"],
				["/api/cache/warm", "probe-cache"],
				["/api/observability/trace", "probe-trace"],
				["/api/observability/burst", "probe-burst"],
				["/api/session/refresh", "probe-session"],
			];

			const setText = (selector, value) => {
				const element = document.querySelector(selector);
				if (element) element.textContent = value;
			};

			setText("[data-debug-id]", debugId);
			setText("[data-preview-url]", window.location.origin);

			for (const [path, marker] of probes) {
				fetch(`${path}?debugId=${encodeURIComponent(debugId)}`, { headers })
					.then(async (response) => {
						const body = await response.json().catch(() => ({}));
						const element = document.querySelector(`[data-probe="${marker}"]`);
						if (element) element.textContent = `${response.status} / ${body.requestId || "logged"}`;
						if (body.counter) setText("[data-counter]", body.counter);
						if (body.cartId) setText("[data-cart-id]", body.cartId);
					})
					.catch(() => {
						const element = document.querySelector(`[data-probe="${marker}"]`);
						if (element) element.textContent = "queued";
					});
			}
		</script>
	</body>
</html>

<style>
	:root {
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: #1d1d1d;
		background: #f4f4f0;
	}

	* {
		box-sizing: border-box;
	}

	body {
		min-height: 100vh;
		margin: 0;
		background:
			radial-gradient(circle at 85% 8%, rgba(246, 130, 31, 0.24), transparent 24rem),
			linear-gradient(135deg, #fff7ed 0, #f4f4f0 38%, #ecece7 100%);
		overflow-x: hidden;
	}

	main {
		display: grid;
		grid-template-columns: 220px minmax(0, 1fr);
		gap: 1rem;
		width: min(1360px, 100%);
		min-height: 100vh;
		margin: 0 auto;
		padding: 1.25rem;
	}

	.sidebar,
	.workspace {
		border: 1px solid #d9d4ca;
		border-radius: 24px;
		background: rgba(255, 255, 255, 0.78);
		box-shadow: 0 24px 70px rgba(63, 43, 23, 0.12);
		backdrop-filter: blur(18px);
	}

	.sidebar {
		position: sticky;
		top: 1rem;
		align-self: start;
		display: grid;
		gap: 1.5rem;
		padding: 1rem;
	}

	.logo-mark {
		display: grid;
		width: 44px;
		height: 44px;
		place-items: center;
		border-radius: 14px;
		color: #fff;
		background: #f6821f;
		font-weight: 900;
		letter-spacing: -0.08em;
	}

	nav {
		display: grid;
		gap: 0.35rem;
	}

	nav a {
		border-radius: 14px;
		padding: 0.85rem 1rem;
		color: #6b6259;
		font-weight: 750;
		text-decoration: none;
	}

	nav a.active,
	nav a:hover {
		color: #1d1d1d;
		background: #fff1df;
	}

	.workspace {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: clamp(1rem, 2vw, 1.25rem);
	}

	.topbar,
	.hero-card,
	.panel-heading,
	.counter-row,
	.event-row,
	.probe-strip {
		display: flex;
		align-items: center;
	}

	.topbar,
	.panel-heading,
	.counter-row {
		justify-content: space-between;
		gap: 1rem;
	}

	.eyebrow,
	.label {
		margin: 0;
		color: #8a5a19;
		font-size: 0.76rem;
		font-weight: 850;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		margin-bottom: 0;
		font-size: clamp(2rem, 3.5vw, 3.2rem);
		line-height: 0.98;
		letter-spacing: -0.06em;
	}

	h2 {
		max-width: 720px;
		margin-bottom: 0.75rem;
		font-size: clamp(2rem, 3.7vw, 3.7rem);
		line-height: 0.98;
		letter-spacing: -0.07em;
	}

	h3 {
		margin-bottom: 0;
		font-size: 1.35rem;
		letter-spacing: -0.03em;
	}

	p {
		max-width: 760px;
		margin-bottom: 0;
		color: #5f5750;
		font-size: 0.98rem;
		line-height: 1.55;
	}

	.status-pill,
	.tag {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border-radius: 999px;
		padding: 0.45rem 0.7rem;
		font-size: 0.82rem;
		font-weight: 800;
	}

	.status-pill {
		color: #14643b;
		background: #e6f6eb;
	}

	.status-pill span,
	.dot {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 999px;
		background: #28a745;
	}

	.hero-card {
		justify-content: space-between;
		gap: 2rem;
		border-radius: 28px;
		padding: 1.6rem 2rem;
		color: #fff;
		background:
			radial-gradient(circle at 80% 20%, rgba(255, 199, 79, 0.42), transparent 18rem),
			linear-gradient(135deg, #171717 0%, #332115 56%, #7a3c00 100%);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16);
	}

	.hero-card p,
	.hero-card .label {
		color: rgba(255, 255, 255, 0.74);
	}

	.url-card {
		display: grid;
		gap: 0.4rem;
		min-width: min(360px, 100%);
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 20px;
		padding: 1rem;
		background: rgba(255, 255, 255, 0.1);
	}

	.url-card span,
	.counter-row span,
	.metrics span,
	.probe-strip span,
	.event-row small {
		color: #7b7168;
		font-size: 0.8rem;
		font-weight: 750;
	}

	.url-card strong {
		overflow: hidden;
		color: #fff;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.9rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.metrics,
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.metrics article,
	.panel,
	.probe-strip {
		border: 1px solid #ded8ce;
		border-radius: 22px;
		background: #fff;
		box-shadow: 0 12px 28px rgba(45, 35, 25, 0.06);
	}

	.metrics article {
		display: grid;
		gap: 0.35rem;
		padding: 0.85rem 1rem;
	}

	.metrics strong {
		font-size: 1.9rem;
		letter-spacing: -0.05em;
	}

	.metrics small {
		color: #8a5a19;
		font-weight: 750;
	}

	.grid {
		grid-template-columns: 1.24fr 0.76fr;
		align-items: stretch;
	}

	.panel {
		padding: 0.9rem 1rem;
	}

	.tag {
		color: #8a4a00;
		background: #fff1df;
	}

	.tag.dark {
		color: #db6d00;
		background: #1d1d1d;
	}

	.counter-row {
		margin: 0.75rem 0;
		border-radius: 18px;
		padding: 0.85rem 1rem;
		background: #f7f2ea;
	}

	.counter-row div {
		display: grid;
		gap: 0.25rem;
	}

	.counter-row [data-counter] {
		font-size: 2.3rem;
		line-height: 1;
		letter-spacing: -0.06em;
	}

	.counter-row strong {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.9rem;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9rem;
	}

	th,
	td {
		border-bottom: 1px solid #ece5db;
		padding: 0.55rem 0.5rem;
		text-align: left;
	}

	th {
		color: #7b7168;
		font-size: 0.75rem;
		text-transform: uppercase;
	}

	td:first-child {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
	}

	.event-list {
		display: grid;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}

	.event-row {
		gap: 0.8rem;
		border-radius: 16px;
		padding: 0.65rem 0.75rem;
		background: #f7f2ea;
	}

	.event-row div {
		display: grid;
		gap: 0.2rem;
		min-width: 0;
	}

	.event-row strong {
		overflow: hidden;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.82rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.event-row em {
		margin-left: auto;
		color: #14643b;
		font-style: normal;
		font-weight: 850;
	}

	.probe-strip {
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0.65rem;
	}

	.probe-strip div {
		display: grid;
		min-width: 150px;
		gap: 0.25rem;
		border-radius: 15px;
		padding: 0.55rem 0.65rem;
		background: #f7f2ea;
	}

	.probe-strip strong {
		overflow: hidden;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.78rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	@media (max-width: 980px) {
		main,
		.grid,
		.metrics,
		.hero-card {
			grid-template-columns: 1fr;
		}

		.sidebar {
			position: static;
		}
	}
</style>
