{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-worker",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-24",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_DO",
        "class_name": "PreviewSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PreviewSession"
      ]
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "WORKER_LABEL": "my-worker"
  },
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "SESSION_DO",
          "class_name": "PreviewSession"
        }
      ]
    },
    "observability": {
      "enabled": true,
      "logs": {
        "enabled": true,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true
      }
    },
    "vars": {
      "APP_ENV": "preview",
      "WORKER_LABEL": "my-worker"
    }
  }
}
